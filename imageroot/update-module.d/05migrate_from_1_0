#
# Instances installed by release 1.0.0 had one TCP port (web) and no setup
# mode, so the current configure-module failed with KeyError: 'SSH_TCP_PORT'
# and the authentication steps with FileNotFoundError on gitea-setup.env.
#
# - SSH_TCP_PORT: use the second allocated port if there is one, otherwise
#   allocate one more port (keeping the web port) and open it in the node
#   firewall, as create-module does for new instances.
# - gitea-setup.env: a 1.0.0 instance whose web installer was completed keeps
#   that "manual" setup, so the module never reinstalls or takes over an
#   existing Gitea; one never set up gets "pending", like a new instance.
#
# Safe to run again: it does nothing on instances that have both.
#

import os
import subprocess
import sys

import agent

if not os.environ.get("SSH_TCP_PORT"):
    ports = [p.strip() for p in os.environ.get("TCP_PORTS", "").split(",") if p.strip()]
    if len(ports) >= 2:
        ssh_port = ports[1]
    else:
        allocated = agent.allocate_ports(1, "tcp", keep_existing=True)
        ssh_port = str(allocated[0] if isinstance(allocated, (list, tuple)) else allocated)
    agent.set_env("SSH_TCP_PORT", ssh_port)
    if not agent.add_public_service(os.environ["MODULE_ID"], [f"{ssh_port}/tcp"], replace_ports=True):
        print(agent.SD_WARNING + "Could not open the Gitea SSH port in the node firewall", file=sys.stderr)
    print(f"Gitea SSH port: {ssh_port}", file=sys.stderr)

def installer_locked():
    """True when the admin finished the Gitea web installer (INSTALL_LOCK)"""
    try:
        mountpoint = subprocess.run(
            ["podman", "volume", "inspect", "gitea-app", "--format", "{{.Mountpoint}}"],
            capture_output=True, text=True, check=True).stdout.strip()
        ini = subprocess.run(
            ["podman", "unshare", "cat", mountpoint + "/gitea/conf/app.ini"],
            capture_output=True, text=True, check=True).stdout
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False
    return any(line.replace(" ", "").lower() == "install_lock=true" for line in ini.splitlines())


if not os.path.exists("gitea-setup.env"):
    # An installed Gitea keeps its own (manual) setup; one whose web installer
    # was never completed can still be set up by the module
    mode = "manual" if installer_locked() else "pending"
    fd = os.open("gitea-setup.env", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as fp:
        fp.write(f"GITEA_SETUP_MODE={mode}\n")
    print(f"Setup mode of the existing Gitea: {mode}", file=sys.stderr)
